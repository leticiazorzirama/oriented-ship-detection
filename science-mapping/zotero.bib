@inproceedings{savathrakis_automated_2024,
	title = {An {Automated} {Method} for the {Creation} of {Oriented} {Bounding} {Boxes} in {Remote} {Sensing} {Ship} {Detection} {Datasets}},
	url = {https://ieeexplore.ieee.org/document/10495701},
	doi = {10.1109/WACVW60836.2024.00095},
	abstract = {In a variety of maritime applications, the task of accurately detecting ships from remote sensing images is of significant importance. Various object detection algorithms localize objects by identifying either their Horizontal Bounding Boxes (HBBs) or their Oriented Bounding Boxes (OBBs). OBBs provide a far more accurate/tighter localization of object regions as well as their orientation. Several ship detection datasets provide annotations that include both HBBs and OBBs. However, many of them do not include OBB annotations. In this work, we propose a method which takes the ships' HBB annotations as input, and automatically calculates the corresponding OBBs. The proposed method consists of three main parts, (a) object segmentation that is built upon the Segment-Anything Model (SAM) to calculate object masks based on the information provided by the HBBs, (b) morphological filtering which eliminates possible artifacts stemming from the segmentation process, and (c) contour detection applied to the post-processed masks that are used to compute the optimal OBBs of the target objects. By automating the process of OBB annotation, the proposed method permits the exploitation of existing HBB-annotated datasets to train ship detectors of improved performance. We support this finding by reporting the results of several experiments that involve standard datasets, as well as state of the art object detectors.},
	urldate = {2025-11-24},
	booktitle = {2024 {IEEE}/{CVF} {Winter} {Conference} on {Applications} of {Computer} {Vision} {Workshops} ({WACVW})},
	author = {Savathrakis, Giorgos and Argyros, Antonis},
	month = jan,
	year = {2024},
	note = {ISSN: 2690-621X},
	keywords = {Object detection, Marine vehicles, Training, Object recognition, Detectors, Annotations, Object segmentation},
	pages = {830--839},
}

@misc{hong_robust_2024-1,
	address = {Rochester, NY},
	type = {{SSRN} {Scholarly} {Paper}},
	title = {Robust {Deep}-{Learning} {Ship} {Detector} for {Medium}-{High} {Resolution} {Images}},
	url = {https://papers.ssrn.com/abstract=4684253},
	doi = {10.2139/ssrn.4684253},
	abstract = {Ship detectors use restricted high-resolution images that require less intelligence to detect ships in small area. However, intelligent robust detection from readily available medium-high (MH) resolution images (10-30 m) is limited. Here, we developed an enhanced Rotated-Ship Detector model (RShipDet), upgraded from Rotation-equivariant Detector (ReDet), and tested its performance for ships around Nansha Islands during 2019 to 2022. Results from the AutoMatic Ship Detector (AMSD) using AI-Earth (AIE) remote-sensing cloud-computing, showed: (1) Gains of 3.3 Average-Precision (AP) on Sentinel2-Ship dataset compared to ReDet; (2) Strong generalization capabilities, with 77.4 AP on SDGSAT-Ship dataset. Nansha Island application showed accurate robust discrimination of complex ship aggregations around the northeast reefs. Our algorithm enables intelligent robust monitoring of ships, using satellite images, in complex ocean environments, for better management of ocean resources and activities.},
	language = {en},
	urldate = {2025-11-24},
	publisher = {Social Science Research Network},
	author = {Hong, Xiaorun and Fu, Dongjie and Tang, Jiasheng and Lyne, Vincent and Luo, Ming and Su, Fenzhen},
	month = jan,
	year = {2024},
	keywords = {deep learning, ship detection, Sentinel-2, SDGSAT-1, median-high resolution optical imagery, rotated-object detection, time-series analysis},
}

@article{azdavay_optimizing_2024,
	title = {Optimizing {Accuracy} and {Efficiency} in {Ship} {Detection} from {Satellite} {Images} through a {Comparative} {Analysis} of {Object} {Detection} {Models}},
	volume = {21},
	copyright = {http://creativecommons.org/licenses/by-nc-nd/4.0},
	issn = {2687-5527},
	url = {https://www.set-science.com/?go=d1001a2417e2b87d5b7c53e16c5e1675&conf_id=98&paper_id=2},
	doi = {10.36287/setsci.21.2.006},
	abstract = {This study evaluates the performance of Faster R-CNN and YOLOv7 object detectors for dynamic ship detection in maritime applications. Both algorithms are tested under challenging conditions, including poor image quality due to cloud and dust obscuration, varying lighting, and high-altitude captures. The necessity for detection methods with high accuracy and efficiency in such environments is discussed. Results show that Faster R-CNN outperforms YOLOv7 in detection accuracy, achieving superior precision, recall, mAP, and F1 scores. This accuracy allows for successful identification and classification of ships even in low-quality images. However, despite its accuracy advantage, Faster R-CNN falls short in speed, with an average detection time of 53.4 seconds, making it less viable for real-time use. Conversely, YOLOv7 processes images significantly faster, with an extraction time of just 21.6 seconds, though at the cost of lower accuracy. Its rapid processing makes YOLOv7 more suitable for real-time applications requiring quick decisions. This study underscores the importance of balancing detection accuracy and speed when selecting an algorithm for ship detection, offering key insights to enhance maritime safety, traffic monitoring, and autonomous navigation systems.},
	language = {en},
	urldate = {2025-11-24},
	journal = {SETSCI - Conference Proceedings},
	author = {Azdavay, Nesli S. and Zajac, Zofia G. and Didis, Hakan M. and Boz, Ilayda},
	month = dec,
	year = {2024},
	note = {Publisher: SETSCI - Conference Proceedings},
	pages = {6--11},
}

@article{yan_rebidet_2023,
	title = {{ReBiDet}: {An} {Enhanced} {Ship} {Detection} {Model} {Utilizing} {ReDet} and {Bi}-{Directional} {Feature} {Fusion}},
	volume = {13},
